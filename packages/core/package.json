{
  "name": "@sanely/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared time units, aliases, and conversion constants for the Sanely libraries",
  "keywords": [
    "duration",
    "milliseconds",
    "time",
    "time-units",
    "units"
  ],
  "homepage": "https://github.com/adelrodriguez/sanely/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/sanely/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/sanely.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/time.js",
  "types": "./dist/time.d.ts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./time": {
      "types": "./dist/time.d.ts",
      "import": "./dist/time.js",
      "default": "./dist/time.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:debug": "tsdown --no-minify --sourcemap",
    "build:verify": "node ../../scripts/verify-build.ts",
    "dev": "tsdown --no-minify --sourcemap --watch",
    "test": "vitest run",
    "test:compat": "node ../../scripts/compat-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
