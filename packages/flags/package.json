{
  "name": "@sanely/flags",
  "version": "0.0.1",
  "private": true,
  "description": "Type-safe feature flag library for TypeScript applications",
  "keywords": [
    "ab-testing",
    "feature-flags",
    "feature-management",
    "feature-toggles",
    "launchdarkly",
    "posthog",
    "react",
    "statsig",
    "type-safe",
    "typescript",
    "variants"
  ],
  "homepage": "https://github.com/adelrodriguez/sanely/tree/main/packages/flags#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/sanely/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/sanely.git",
    "directory": "packages/flags"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/integrations/react/index.d.ts",
      "import": "./dist/integrations/react/index.js",
      "default": "./dist/integrations/react/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:debug": "tsdown --no-minify --sourcemap",
    "build:verify": "node scripts/verify-package.ts",
    "dev": "tsdown --no-minify --sourcemap --watch",
    "test": "vitest run --coverage",
    "test:compat": "node ../../scripts/compat-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
