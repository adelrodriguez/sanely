{
  "name": "@sanely/skew",
  "version": "0.0.1",
  "description": "Keep your deployments fresh",
  "keywords": [
    "deployment",
    "react-hook",
    "stale-client",
    "version-skew",
    "vite-plugin"
  ],
  "homepage": "https://github.com/adelrodriguez/sanely/tree/main/packages/skew#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/sanely/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/sanely.git",
    "directory": "packages/skew"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/integrations/react/index.d.ts",
      "import": "./dist/integrations/react/index.js"
    },
    "./vite": {
      "types": "./dist/adapters/vite/index.d.ts",
      "import": "./dist/adapters/vite/index.js"
    },
    "./next": {
      "types": "./dist/adapters/next/index.d.ts",
      "import": "./dist/adapters/next/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:debug": "tsdown --no-minify --sourcemap",
    "build:verify": "node scripts/verify-package-contract.ts",
    "dev": "tsdown --no-minify --sourcemap --watch",
    "test": "vitest run",
    "test:compat": "node ../../scripts/compat-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sanely/duration": "workspace:^"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@sanely/core": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "8.3.7",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
