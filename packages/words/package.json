{
  "name": "@sanely/words",
  "version": "0.0.1",
  "private": true,
  "description": "Generate friendly, safe-for-work names from curated word lists",
  "keywords": [
    "friendly",
    "generator",
    "name",
    "random",
    "username",
    "words"
  ],
  "homepage": "https://github.com/adelrodriguez/sanely/tree/main/packages/words#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/sanely/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/sanely.git",
    "directory": "packages/words"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:debug": "tsdown --no-minify --sourcemap",
    "build:verify": "node ../../scripts/verify-build.ts",
    "dev": "tsdown --no-minify --sourcemap --watch",
    "scan": "node scripts/scan.ts",
    "test": "vitest run",
    "test:compat": "node ../../scripts/compat-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
