{
  "name": "@sanely/cron",
  "version": "0.0.1",
  "description": "A small, type-safe English-like language that compiles to exact cron expressions",
  "keywords": [
    "cron",
    "crontab",
    "human-readable",
    "schedule",
    "type-safe"
  ],
  "homepage": "https://github.com/adelrodriguez/sanely/tree/main/packages/cron#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/sanely/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/sanely.git",
    "directory": "packages/cron"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:debug": "tsdown --no-minify --sourcemap",
    "build:verify": "node ../../scripts/verify-build.ts",
    "dev": "tsdown --no-minify --sourcemap --watch",
    "test": "vitest run",
    "test:compat": "node ../../scripts/compat-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "test:types-perf": "node scripts/typecheck-perf.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sanely/duration": "workspace:*",
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "croner": "10.0.1",
    "fast-check": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
