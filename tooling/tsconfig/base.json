{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "adamantite/typescript",
  "display": "Default",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  }
}
