{
  "name": "sanely",
  "private": true,
  "description": "TypeScript libraries with sane defaults",
  "homepage": "https://github.com/adelrodriguez/sanely#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/sanely/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/sanely.git"
  },
  "type": "module",
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "turbo run build",
    "build:verify": "turbo run build:verify",
    "bump:deps": "pnpm update --interactive --recursive",
    "check": "adamantite check",
    "dev": "turbo run dev",
    "fix": "adamantite fix",
    "generate": "turbo generate",
    "release": "changeset publish",
    "test": "pnpm run test:rules && turbo run test",
    "test:compat": "turbo run test:compat",
    "test:rules": "node --test .adamantite/lint/__tests__/*.test.ts",
    "version": "changeset version && pnpm run fix"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@tooling/tsconfig": "workspace:*",
    "@turbo/gen": "2.11.10",
    "@types/node": "catalog:",
    "adamantite": "0.46.0",
    "knip": "6.42.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-plugin-react-doctor": "0.9.18",
    "packref": "0.3.7",
    "sherif": "1.13.0",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
